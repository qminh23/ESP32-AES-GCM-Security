# Copy to .env.local, fill in your broker, then load in bash/zsh:
# set -a
# source .env.local
# set +a
MQTT_BROKER=mqtt.example.com
MQTT_PORT=8883
MQTT_USER=YOUR_MQTT_USER
MQTT_PASS=YOUR_MQTT_PASSWORD
# MQTT_CA_FILE=/absolute/path/to/broker-ca.crt
# AES_KEY_HEX must match s_system_key in main/crypto_app.c (32 HEX characters).
# DASHBOARD_DB=/absolute/path/to/iot_history.sqlite3
# MQTT_TLS_KEYLOG is only for controlled TLS inspection in the lab.
